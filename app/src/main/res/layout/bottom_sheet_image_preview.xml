<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:padding="@dimen/_16sdp">

    <!-- Drag Handle -->
    <View
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_4sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/_16sdp"
        android:backgroundTint="@color/black"
        android:background="@drawable/card_background"/>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Update Profile Photo"
        android:textColor="@color/black"
        android:textSize="@dimen/_16sdp"
        android:fontFamily="@font/inter_semibold"/>

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="Choose a new profile picture"
        android:textColor="#666666"
        android:textSize="@dimen/_11sdp"
        android:fontFamily="@font/inter"/>

    <!-- Image Preview Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_180sdp"
        android:layout_height="@dimen/_180sdp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_24sdp"
        app:cardCornerRadius="@dimen/_90sdp"
        app:cardElevation="@dimen/_8sdp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Preview Image -->
            <ImageView
                android:id="@+id/previewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo"/>

            <!-- Loading Overlay -->
            <FrameLayout
                android:id="@+id/loadingOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#80000000"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/white"/>
            </FrameLayout>

            <!-- Edit Icon Overlay -->
            <ImageView
                android:id="@+id/editIconOverlay"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/_20sdp"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/camera_icon"
                android:background="@drawable/card_background"
               />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Image Info -->
    <LinearLayout
        android:id="@+id/imageInfoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/_12sdp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:src="@drawable/ic_image_info"
            app:tint="#666666"/>

        <TextView
            android:id="@+id/imageInfoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:text="image.jpg • 1.2 MB"
            android:textColor="#666666"
            android:textSize="@dimen/_10sdp"
            android:fontFamily="@font/inter"/>
    </LinearLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_24sdp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Choose Image Button -->
        <Button
            android:id="@+id/btnChooseImage"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/_8sdp"
            android:text="Choose Photo"
            android:textAllCaps="false"
            android:textColor="@color/blue"
            android:fontFamily="@font/inter_semibold"
            android:textSize="@dimen/_12sdp"
            app:icon="@drawable/ic_calendar_small"
            app:iconGravity="textStart"
            app:iconTint="@color/blue"
            app:strokeColor="@color/blue"
            android:background="@drawable/card_background"
            app:strokeWidth="1dp"
            app:cornerRadius="@dimen/_12sdp"
            />

        <!-- Upload Button -->
        <Button
            android:id="@+id/btnUpload"
            android:layout_width="0dp"
            android:layout_height="@dimen/_48sdp"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Upload"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_semibold"
            android:textSize="@dimen/_12sdp"
            android:enabled="false"
            android:alpha="0.8"
            android:background="@drawable/card_background"
            app:backgroundTint="@color/blue"
           />
    </LinearLayout>

    <!-- Cancel Button -->
    <Button
        android:id="@+id/btnCancel"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginTop="@dimen/_12sdp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#666666"
        android:textSize="@dimen/_12sdp"
        android:elevation="@dimen/_10sdp"
        android:background="@drawable/card_background"
        app:backgroundTint="#F5F5F5"
       />

</LinearLayout>